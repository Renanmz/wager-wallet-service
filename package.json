{
  "name": "wager-wallet-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npx tsc --noEmit",
    "test": "npx tsx --test tests/**/*.spec.ts",
    "test:bun": "bun test",
    "lint": "npx tsc --noEmit",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "migrate:up": "bun run scripts/migrate-up.ts",
    "migrate:down": "bun run scripts/migrate-down.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@mikro-orm/core": "^6.6.17",
    "@mikro-orm/migrations": "^6.6.17",
    "@mikro-orm/nestjs": "^6.1.2",
    "@mikro-orm/postgresql": "^6.6.17",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.4.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "bun-types": "^1.1.25",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
